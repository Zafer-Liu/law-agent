# 复制为 .env 用于本地开发；生产环境改用部署平台的环境变量。

# OpenAI 兼容接口根地址（以 /v1 结尾），不预选任何服务商。
LAW_LLM_BASE_URL=
LAW_LLM_API_KEY=
LAW_LLM_MODEL=MiniMax-M3
# 单次输出预算（500-200000）。
LAW_LLM_MAX_TOKENS=8000

# 可选的备用模型：主模型失败（故障/额度/输出无效）时接管，同一套 OpenAI 兼容协议。
LAW_LLM_FALLBACK_BASE_URL=
LAW_LLM_FALLBACK_API_KEY=
LAW_LLM_FALLBACK_MODEL=
LAW_LLM_FALLBACK_MAX_TOKENS=8000

# 模拟法庭独立模型。M2.7-highspeed 侧重庭审多轮响应速度。
LAW_COURT_LLM_BASE_URL=
LAW_COURT_LLM_API_KEY=
LAW_COURT_LLM_MODEL=MiniMax-M2.7-highspeed
LAW_COURT_LLM_MAX_TOKENS=8000

# 可选的模拟法庭备用模型。
LAW_COURT_LLM_FALLBACK_BASE_URL=
LAW_COURT_LLM_FALLBACK_API_KEY=
LAW_COURT_LLM_FALLBACK_MODEL=
LAW_COURT_LLM_FALLBACK_MAX_TOKENS=8000

# 可选向量服务（语义检索）。两种风格自动识别，也可用 LAW_EMBED_STYLE 强制指定：
#  - OpenAI 兼容 embeddings 端点（input/data），如自建 BGE；
#  - MiniMax embo-01（texts/type 非对称：入库 db / 检索 query），与主模型同一账号 key。
# 配置后语义检索生效；更换向量模型后需要重新索引。
# 未配置时自动降级为词法 + FTS5 检索。
LAW_EMBED_BASE_URL=https://api.minimax.cn/v1
LAW_EMBED_API_KEY=
LAW_EMBED_MODEL=embo-01
# LAW_EMBED_STYLE=openai|minimax（缺省按域名/模型名自动判断）

# 可选 Jev 检索质量门控：在 RRF 候选之后过滤低相关片段与提示注入。
# 未配置、关闭或调用失败时保留原检索结果，不阻断回答。
TYPESAFE_API_KEY=
LAW_JEV_GATE=1
LAW_JEV_REL_MIN=2.0
LAW_JEV_INJ_MAX=0.5
LAW_JEV_EXCERPT_CHARS=600

# 联网搜索（智谱 web_search_prime MCP，GLM Coding Plan Key）：配置后问答输入区出现「联网搜索」开关
LAW_WEBSEARCH_API_KEY=
# 可选覆盖：置空并设 LAW_WEBSEARCH_BASE_URL 可改走智谱 tools API（web-search-pro，普通智谱 Key）
# LAW_WEBSEARCH_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp

# 数据目录（SQLite 与上传文件）。留空使用 .law-data。
LAW_DATA_DIR=
# 本地端口。
LAW_PORT=5000
